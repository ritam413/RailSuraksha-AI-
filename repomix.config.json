{
  "output": {
    "filePath": "repomix-output.md",
    "style": "markdown",
    "parsableStyle": false,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "showLineNumbers": true
  },
  "include": [
    "**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules/**",
      ".next/**",
      ".git/**",
      ".agents/**",
      ".gemini/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "*.log",
      "repomix-output.*",
      "data/*.json",
      "docs/mockup/assets/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
